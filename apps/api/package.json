{
  "name": "@kiataker/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(api: lint via typecheck for now)\"",
    "test": "vitest run",
    "test:int": "vitest run"
  },
  "dependencies": {
    "@kiataker/contracts": "workspace:*",
    "@kiataker/copy": "workspace:*",
    "@kiataker/db": "workspace:*",
    "@kiataker/domain": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "jsonwebtoken": "9.0.2",
    "pdf-lib": "1.17.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "concurrently": "9.1.0",
    "supertest": "7.0.0",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
