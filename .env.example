# Kiataker environment template. Going live is a configuration change, never a code change.
# Copy to .env.local for local development. Every variable below is read by the code
# (apps/api/src/common/config/env.ts, apps/web/next.config.mjs, packages/db).
#
# NOTE: WhatsApp, Paystack and AI *credentials* are NOT environment variables. Staff enter
# them in the admin at /admin/ai (Integrations & keys); they are stored in the database
# `setting` table. The env only selects the adapter mode (WHATSAPP_ADAPTER etc. below).

# ---- Core ----
NODE_ENV=development
TZ=Africa/Lagos

# ---- Database (PostgreSQL 16) ----
# Local dev uses the machine's Postgres. Docker Compose users: host=localhost port=5433.
DATABASE_URL="postgresql://scotteneje@localhost:5432/kiataker_dev?schema=public"
# Only needed for `pnpm --filter @kiataker/db migrate:check` (CI / local), not in production.
SHADOW_DATABASE_URL="postgresql://scotteneje@localhost:5432/kiataker_shadow?schema=public"

# ---- API ----
API_PORT=4000
# Public URL of the API. Also read by the web app at BUILD time (next.config.mjs inlines it
# into the browser bundle), so on Vercel it must be set before building and be publicly reachable.
API_BASE_URL=http://localhost:4000
# Public URL of the web app. This is the ONLY origin the API's CORS allows.
WEB_BASE_URL=http://localhost:3000

# ---- Auth / sessions ----
# WARNING: JWT_ACCESS_SECRET also derives the AES key that encrypts stored data
# (common/crypto/crypto.service.ts). Set it once per environment and never rotate it,
# or previously encrypted data becomes unreadable.
# With NODE_ENV=production the API refuses to start unless both secrets are 32+ random
# characters, differ from each other, and are not these dev values. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ---- Adapters: default to in-memory fakes locally ----
# WHATSAPP_ADAPTER: fake | meta     (meta = real Meta Cloud API; keys entered in /admin/ai)
# PAYMENTS_ADAPTER: fake | paystack (keys entered in /admin/ai)
# AI_ADAPTER:       fake | hosted   (provider, model and key chosen in /admin/ai)
WHATSAPP_ADAPTER=fake
PAYMENTS_ADAPTER=fake
AI_ADAPTER=fake

# ---- AI key from the environment (optional) ----
# Used when no key is saved in /admin/ai (a key saved there wins). The provider is detected
# from the key prefix (AIza = Google Gemini, sk-ant- = Anthropic, sk- = OpenAI); set
# AI_PROVIDER (anthropic | openai | google) if the key has another format. AI_MODEL defaults
# to the provider's recommended model (Gemini: gemini-3.5-flash-lite).
AI_API_KEY=
AI_PROVIDER=
AI_MODEL=

# ---- Dev tools ----
# The WhatsApp simulator routes, one-time codes echoed in API responses, and the "mark paid"
# test completion. They let anyone act as any phone number. Unset = on in development, OFF when
# NODE_ENV=production. Never set DEV_TOOLS=true on a public deployment.
DEV_TOOLS=

# ---- Proxy ----
# Express "trust proxy", so rate limits see the real client IP behind a load balancer.
# Unset = 1 hop in production (right for Render/Railway/Fly/AWS ALB), off in development.
TRUST_PROXY=

# ---- Uploads ----
# Where CMS uploads are written and served from (/uploads/<file>). Defaults to apps/api/uploads.
# In production point this at a persistent disk/volume, or uploads are lost on redeploy.
UPLOADS_DIR=

# ---- Security hardening (Phase 5) ----
# Per-IP fixed-window rate limiting (in memory, per instance). Generous for dev;
# production suggestion: RATE_LIMIT_MAX=600, RATE_LIMIT_AUTH_MAX=20.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5000
RATE_LIMIT_AUTH_MAX=60

# ---- Observability (Phase 5) ----
# Set a Sentry DSN to forward unexpected server errors. Blank = structured logs only, no forward.
SENTRY_DSN=
# Build commit reported by /v1/health. Optional.
GIT_COMMIT=

# ---- Background workers (optional; set to 1 to switch off on an instance) ----
DISABLE_ACTION_POLLER=
DISABLE_RENT_SCAN=
