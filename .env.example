# Kiataker environment template. Going live is a configuration change, never a code change.
# Copy to .env.local for local development. Every live value is read from here or the secrets store.

# ---- Core ----
NODE_ENV=development
TZ=Africa/Lagos

# ---- Database (PostgreSQL 16) ----
# Local dev uses the machine's Postgres. Docker Compose users: host=localhost port=5433.
DATABASE_URL="postgresql://scotteneje@localhost:5432/kiataker_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://scotteneje@localhost:5432/kiataker_shadow?schema=public"

# ---- API ----
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ---- Auth / sessions ----
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ---- Object storage (S3-compatible; MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=af-south-1
S3_BUCKET=kiataker-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ---- Email (Postmark in prod; Mailpit locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Kiataker <no-reply@kiataker.ng>"

# ---- Adapters: default to in-memory fakes locally ----
WHATSAPP_ADAPTER=fake
PAYMENTS_ADAPTER=fake
AI_ADAPTER=fake
STORAGE_ADAPTER=local

# ---- Security hardening (Phase 5) ----
# Per-IP fixed-window rate limiting. Defaults are generous for dev; tighten in production.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5000
RATE_LIMIT_AUTH_MAX=60

# ---- Observability (Phase 5) ----
# Set a Sentry DSN to forward unexpected server errors. Blank = structured logs only, no forward.
SENTRY_DSN=
SCANNER_ADAPTER=fake

# ---- WhatsApp (Meta Cloud API) — set to turn the real adapter on ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Payments (Paystack) — set to turn the real adapter on ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---- AI (hosted LLM, constrained) ----
AI_API_KEY=
AI_MODEL=
